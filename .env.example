# Copie ce fichier en ".env" et remplis les valeurs.
SECRET_KEY=change-moi-par-une-phrase-longue

# Par defaut : SQLite (rien a installer). Pour MySQL, decommente la ligne suivante :
# DATABASE_URL=mysql+pymysql://root:TON_MOT_DE_PASSE@localhost/codespeak

# Optionnel : correction par IA (sinon des regles simples sont utilisees)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optionnel : transcription de l'audio cote serveur (sinon le navigateur Chrome transcrit)
OPENAI_API_KEY=
